/*
 * ARDUINO NANO - Sensor + Kontroler Kipas + LCD + INA219 Chiller Susu
 * Versi non-blocking (tanpa delay, semua pakai millis)
 * Tabel pin & protokol ESP32 sama seperti versi sebelumnya.
 */

#include <Wire.h>
#include <Adafruit_BME280.h>
#include <Adafruit_INA219.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <SoftwareSerial.h>
#include <LiquidCrystal_I2C.h>

// ---------------- DEFINISI PIN ----------------
#define PIN_DS18B20    2
#define PIN_RELAY      7
#define PIN_SOFT_RX    10     // <- ESP32 GPIO17 (TX2)
#define PIN_SOFT_TX    11     // -> ESP32 GPIO16 (RX2) via divider
// -----------------------------------------------

#define RELAY_ACTIVE   LOW
#define BME_ADDR       0x76
#define LCD_ADDR       0x27
#define INA_ADDR       0x40

// Kontrol suhu susu (DS18B20)
const float TEMP_ON  = 30.0;
const float TEMP_OFF = 28.0;

// ---------------- TIMING (millis) ----------------
#define SEND_INTERVAL    2000UL  // periode siklus baca + kirim
#define DS_CONV_MS        800UL  // waktu tunggu konversi DS18B20 12-bit (min 750 ms)
#define MSG_HOLD_MS      1500UL  // lama pesan error di LCD saat startup
#define BME_RETRY_MS     5000UL  // jeda antar percobaan init ulang BME280
#define BME_STUCK_LIMIT     10   // data BME identik 10x berturut-turut = dianggap macet

SoftwareSerial toESP(PIN_SOFT_RX, PIN_SOFT_TX);
Adafruit_BME280 bme;
Adafruit_INA219 ina(INA_ADDR);
OneWire oneWire(PIN_DS18B20);
DallasTemperature ds18(&oneWire);
LiquidCrystal_I2C lcd(LCD_ADDR, 16, 2);

bool bmeOK = false;
bool inaOK = false;
bool fanOn = false;
bool autoMode = true;
String rxLine;

// state untuk non-blocking
bool dsWaiting = false;                 // sedang menunggu konversi DS18B20?
unsigned long lastCycle = 0;            // kapan siklus terakhir dimulai
unsigned long dsReqTime = 0;            // kapan requestTemperatures dikirim
unsigned long lcdHoldUntil = 0;         // LCD tidak di-update sampai waktu ini
unsigned long lastBmeRetry = 0;
float lastHum = NAN, lastPres = NAN;
uint8_t bmeStuck = 0;

void setFan(bool on) {
  fanOn = on;
  digitalWrite(PIN_RELAY, on ? RELAY_ACTIVE : !RELAY_ACTIVE);
}

void handleCommand(const String& line) {
  if (!line.startsWith("CMD,")) return;
  String c = line.substring(4);
  c.trim();
  if (c == "AUTO")          autoMode = true;
  else if (c == "FAN_ON")   { autoMode = false; setFan(true);  }
  else if (c == "FAN_OFF")  { autoMode = false; setFan(false); }
}

void readESP() {
  while (toESP.available()) {
    char ch = toESP.read();
    if (ch == '\n') { handleCommand(rxLine); rxLine = ""; }
    else if (ch != '\r' && rxLine.length() < 30) rxLine += ch;
  }
}

void readINA(float &volt, float &curr_mA) {
  if (!inaOK) { volt = 0; curr_mA = 0; return; }
  float busV     = ina.getBusVoltage_V();
  float shunt_mV = ina.getShuntVoltage_mV();
  volt    = busV + (shunt_mV / 1000.0);
  curr_mA = ina.getCurrent_mA();
  if (curr_mA < 0) curr_mA = 0;
}

// Baca BME280 dengan deteksi macet + init ulang otomatis
void readBME(float &hum, float &pres) {
  hum = NAN; pres = NAN;
  unsigned long now = millis();

  // Kalau sensor sedang dianggap mati, coba init ulang berkala (non-blocking)
  if (!bmeOK) {
    if (now - lastBmeRetry >= BME_RETRY_MS) {
      lastBmeRetry = now;
      bmeOK = bme.begin(BME_ADDR);   // begin() menulis ulang konfigurasi sensor
      bmeStuck = 0;
      lastHum = NAN; lastPres = NAN;
      Serial.println(bmeOK ? F("BME280 pulih") : F("BME280 masih error"));
    }
    if (!bmeOK) return;
  }

  float h = bme.readHumidity();
  float p = bme.readPressure() / 100.0F;

  // Data tidak masuk akal -> kemungkinan koneksi putus / sensor reset
  bool invalid = isnan(h) || isnan(p) || h <= 0 || h > 100 || p < 300 || p > 1100;
  if (invalid) {
    bmeOK = false;
    lastBmeRetry = now - BME_RETRY_MS;   // coba init ulang di siklus berikutnya
    Serial.println(F("BME280 data invalid, reinit..."));
    return;
  }

  // Data persis sama berkali-kali -> sensor "beku" (misal masuk sleep mode)
  if (h == lastHum && p == lastPres) {
    if (++bmeStuck >= BME_STUCK_LIMIT) {
      bmeOK = false;
      lastBmeRetry = now - BME_RETRY_MS;
      Serial.println(F("BME280 macet, reinit..."));
      return;
    }
  } else {
    bmeStuck = 0;
  }
  lastHum = h; lastPres = p;
  hum = h; pres = p;
}

void updateLcd(float tDS, float hum, float pres) {
  char l1[17], l2[17], t[8], h[6], p[8];
  if (isnan(tDS)) strcpy(t, "--.-"); else dtostrf(tDS, 4, 1, t);
  if (isnan(hum)) strcpy(h, "--");   else dtostrf(hum, 2, 0, h);
  if (isnan(pres)) strcpy(p, "----"); else dtostrf(pres, 4, 0, p);
  snprintf(l1, sizeof(l1), "T:%sC H:%s%%   ", t, h);
  snprintf(l2, sizeof(l2), "P:%s Fan:%s%c  ", p, fanOn ? "ON " : "OFF",
           autoMode ? 'A' : 'M');
  lcd.setCursor(0, 0); lcd.print(l1);
  lcd.setCursor(0, 1); lcd.print(l2);
}

void setup() {
  Serial.begin(9600);
  toESP.begin(9600);

  pinMode(PIN_RELAY, OUTPUT);
  setFan(false);

  Wire.begin();
  #ifdef WIRE_HAS_TIMEOUT
    Wire.setWireTimeout(3000, true);   // cegah program hang kalau bus I2C macet
  #endif

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0); lcd.print(F("Chiller Susu"));

  ds18.begin();
  ds18.setWaitForConversion(false);    // PENTING: non-blocking

  bmeOK = bme.begin(BME_ADDR);
  inaOK = ina.begin();
  if (inaOK) ina.setCalibration_32V_1A();

  // Tampilkan pesan error tanpa delay: cukup tahan LCD selama MSG_HOLD_MS
  if (!bmeOK || !inaOK) {
    lcd.setCursor(0, 1);
    if (!bmeOK && !inaOK) lcd.print(F("BME+INA error  "));
    else if (!bmeOK)      lcd.print(F("BME280 error   "));
    else                  lcd.print(F("INA219 error   "));
    Serial.println(F("Ada sensor yang tidak terdeteksi!"));
    lcdHoldUntil = millis() + MSG_HOLD_MS;
  }
}

void loop() {
  readESP();   // selalu jalan, tidak pernah terblokir

  unsigned long now = millis();

  // TAHAP 1: mulai konversi suhu tiap SEND_INTERVAL
  if (!dsWaiting && now - lastCycle >= SEND_INTERVAL) {
    lastCycle = now;
    ds18.requestTemperatures();   // langsung return, tidak menunggu
    dsReqTime = now;
    dsWaiting = true;
  }

  // TAHAP 2: konversi selesai -> baca semua sensor, kontrol, tampil, kirim
  if (dsWaiting && now - dsReqTime >= DS_CONV_MS) {
    dsWaiting = false;

    float tDS = ds18.getTempCByIndex(0);
    if (tDS == DEVICE_DISCONNECTED_C) tDS = NAN;

    float hum, pres;
    readBME(hum, pres);

    float fanV = 0, fanI = 0;
    readINA(fanV, fanI);

    // Kontrol kipas AUTO (histeresis, fail-safe ON bila sensor rusak)
    if (autoMode) {
      if (isnan(tDS))            setFan(true);
      else if (tDS >= TEMP_ON)   setFan(true);
      else if (tDS <= TEMP_OFF)  setFan(false);
    }

    if (millis() >= lcdHoldUntil) updateLcd(tDS, hum, pres);

    // Kirim ke ESP32
    toESP.print(F("DATA,"));
    toESP.print(tDS, 2);   toESP.print(',');
    toESP.print(hum, 2);   toESP.print(',');
    toESP.print(pres, 2);  toESP.print(',');
    toESP.print(fanOn ? 1 : 0); toESP.print(',');
    toESP.print(autoMode ? 1 : 0); toESP.print(',');
    toESP.print(fanV, 2);  toESP.print(',');
    toESP.println(fanI, 1);

    // Debug
    Serial.print(F("DS18B20=")); Serial.print(tDS);
    Serial.print(F(" H="));      Serial.print(hum);
    Serial.print(F(" P="));      Serial.print(pres);
    Serial.print(F(" Fan="));    Serial.print(fanOn ? F("ON") : F("OFF"));
    Serial.print(F(" V="));      Serial.print(fanV, 2);
    Serial.print(F(" I="));      Serial.print(fanI, 1);
    Serial.println(F("mA"));
  }
}
